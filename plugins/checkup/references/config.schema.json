{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CaioGiasson/cainitech-plugins/plugins/checkup/references/config.schema.json",
  "title": "cainitech checkup repository configuration",
  "description": "Format of .checkup.json at the root of an assessed repository (CONFIG.md). It records accepted risks, items that do not apply and paths outside the scope. It cannot change severities, weights, the score formula or the classification.",
  "type": "object",
  "required": ["version"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "enum": ["1.0.0"] },
    "exceptions": { "type": "array", "items": { "$ref": "#/$defs/exception" } },
    "exclude": { "type": "array", "items": { "$ref": "#/$defs/exclusion" } }
  },
  "$defs": {
    "exception": {
      "type": "object",
      "required": ["id", "type", "reason", "owner", "expires"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^(SEC|PERF|PRIV|AIR)-\\d+\\.\\d{2}$" },
        "type": { "type": "string", "enum": ["acceptedRisk", "notApplicable"] },
        "reason": { "type": "string", "minLength": 10 },
        "owner": { "type": "string", "minLength": 1, "description": "a person or team accountable for the decision" },
        "expires": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "at most 12 months after the assessment" },
        "reference": { "type": "string", "description": "link to the decision record, ticket or approval" }
      }
    },
    "exclusion": {
      "type": "object",
      "required": ["path", "reason"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1, "description": "glob relative to the repository root" },
        "reason": { "type": "string", "minLength": 10 }
      }
    }
  }
}
